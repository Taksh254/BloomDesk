{
  "name": "BloomDesk",
  "version": 4,
  "theme": "Crayon Box",
  "dark": "prefers-color-scheme, or force with html[data-theme=dark|light]",
  "shared": {
    "color": {
      "success": {
        "light": "#4A7C5C",
        "dark": "#8BC2A0",
        "usage": "Leaf. Present, paid, done."
      },
      "success-soft": {
        "light": "#EAF3ED",
        "dark": "#1F3328",
        "usage": "Success tint."
      },
      "success-ink": {
        "light": "#335942",
        "dark": "#A9D4B9",
        "usage": "Text on success-soft."
      },
      "on-success": {
        "light": "#FFFFFF",
        "dark": "#132A1C",
        "usage": "Text and icons on a solid success fill (Present button)."
      },
      "warning": {
        "light": "#8A6630",
        "dark": "#D9B472",
        "usage": "Late, due soon (as text/icon)."
      },
      "warning-soft": {
        "light": "#FAF1E2",
        "dark": "#33301F",
        "usage": "Warning tint."
      },
      "warning-ink": {
        "light": "#6B4E22",
        "dark": "#E6CC98",
        "usage": "Text on warning-soft."
      },
      "danger": {
        "light": "#A9554B",
        "dark": "#E39A90",
        "usage": "Sindoor. Absent, overdue, destructive."
      },
      "danger-soft": {
        "light": "#F8EAE8",
        "dark": "#3A2523",
        "usage": "Danger tint."
      },
      "danger-ink": {
        "light": "#7E3A32",
        "dark": "#F0BDB6",
        "usage": "Text on danger-soft."
      },
      "on-danger": {
        "light": "#FFFFFF",
        "dark": "#2C1210",
        "usage": "Text and icons on a solid danger fill (Absent, Remove)."
      },
      "info": {
        "light": "#4D7099",
        "dark": "#93B4D9",
        "usage": "Sky. On leave, informational."
      },
      "info-soft": {
        "light": "#EAF0F7",
        "dark": "#1F2C3B",
        "usage": "Info tint."
      },
      "info-ink": {
        "light": "#36557A",
        "dark": "#B5CDE8",
        "usage": "Text on info-soft."
      }
    },
    "type": {
      "display": {
        "role": "display",
        "weight": 600,
        "size": "40px",
        "lineHeight": "44px",
        "usage": "Parent greeting, one hero number per screen."
      },
      "h1": {
        "role": "display",
        "weight": 600,
        "size": "30px",
        "lineHeight": "38px",
        "usage": "Page titles."
      },
      "h2": {
        "role": "display",
        "weight": 600,
        "size": "22px",
        "lineHeight": "28px",
        "usage": "Section titles, Parent card titles."
      },
      "h3": {
        "role": "body",
        "weight": 500,
        "size": "18px",
        "lineHeight": "24px",
        "usage": "Card titles in Owner and Teacher."
      },
      "body": {
        "role": "body",
        "weight": 400,
        "size": "16px",
        "lineHeight": "26px",
        "usage": "Default text on mobile."
      },
      "body-sm": {
        "role": "body",
        "weight": 400,
        "size": "14px",
        "lineHeight": "22px",
        "usage": "Owner tables, dense lists."
      },
      "label": {
        "role": "body",
        "weight": 500,
        "size": "13px",
        "lineHeight": "18px",
        "usage": "Field labels, table headers (sentence case)."
      },
      "caption": {
        "role": "body",
        "weight": 500,
        "size": "12px",
        "lineHeight": "16px",
        "usage": "Timestamps, helper text."
      }
    },
    "space": {
      "0": "0",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    },
    "shadow": {
      "sm": {
        "light": "0 1px 2px rgba(31,45,74,.05)",
        "dark": "0 1px 2px rgba(0,0,0,.25)"
      },
      "md": {
        "light": "0 6px 20px rgba(31,45,74,.07)",
        "dark": "0 6px 20px rgba(0,0,0,.3)"
      },
      "lg": {
        "light": "0 16px 40px rgba(31,45,74,.12)",
        "dark": "0 16px 40px rgba(0,0,0,.4)"
      }
    },
    "touch": {
      "min": "44px",
      "teacher": "56px"
    }
  },
  "themes": {
    "crayon": {
      "name": "Crayon Box",
      "description": "A child's notebook. Ruled pages, crayon colours for each class, doodled suns and stars, gold stars for attendance.",
      "font": {
        "display": "'Fredoka', 'Baloo 2', system-ui, sans-serif",
        "body": "'Nunito', 'Mukta', system-ui, sans-serif",
        "hand": "'Kalam', 'Mukta', cursive"
      },
      "radius": {
        "xs": "10px",
        "sm": "14px",
        "md": "16px",
        "lg": "24px",
        "pill": "999px"
      },
      "color": {
        "bg": {
          "light": "#FAFBFE",
          "dark": "#141A2A",
          "usage": "Page background (owner web, app screens)."
        },
        "surface": {
          "light": "#FFFFFF",
          "dark": "#1B2235",
          "usage": "Cards, sheets, table rows."
        },
        "surface-2": {
          "light": "#EEF3FB",
          "dark": "#232C43",
          "usage": "Muted fills: table headers, input wells, segmented controls."
        },
        "border": {
          "light": "#DCE5F2",
          "dark": "#2E3852",
          "usage": "Hairlines, card and input borders."
        },
        "border-strong": {
          "light": "#7A8BA6",
          "dark": "#5F6D8C",
          "usage": "Input borders on focus-less state, dividers that must read (3:1)."
        },
        "ink": {
          "light": "#1F2D4A",
          "dark": "#E3E9F5",
          "usage": "Primary text."
        },
        "ink-2": {
          "light": "#4A5878",
          "dark": "#A8B3CB",
          "usage": "Secondary text, labels."
        },
        "ink-3": {
          "light": "#5E6B88",
          "dark": "#8D99B3",
          "usage": "Muted text: timestamps, hints (still 4.5:1 on surface)."
        },
        "primary": {
          "light": "#2E5FBF",
          "dark": "#8EB0F0",
          "usage": "Calm peacock. Brand colour: primary buttons, links, active nav, focus ring."
        },
        "primary-hover": {
          "light": "#244E9F",
          "dark": "#A9C3F5",
          "usage": "Primary hover / pressed."
        },
        "primary-soft": {
          "light": "#E6EEFB",
          "dark": "#22325A",
          "usage": "Selected rows, active nav background, info banners."
        },
        "on-primary": {
          "light": "#FFFFFF",
          "dark": "#0F1A33",
          "usage": "Text and icons on primary."
        },
        "accent": {
          "light": "#FFC93C",
          "dark": "#F5C24A",
          "usage": "Soft marigold. Highlights, quick-action FAB, celebration moments. Never body text on white."
        },
        "accent-soft": {
          "light": "#FFF4D6",
          "dark": "#3A3018",
          "usage": "Marigold tint backgrounds: today's highlight, due-soon banners."
        },
        "accent-ink": {
          "light": "#7A5300",
          "dark": "#F7D88A",
          "usage": "Text on accent-soft."
        },
        "on-accent": {
          "light": "#3A2800",
          "dark": "#2E2100",
          "usage": "Text and icons on accent."
        },
        "class-playgroup": {
          "light": "#C8443A",
          "dark": "#F29A90",
          "usage": "Crayon tag: Playgroup (lotus)."
        },
        "class-nursery": {
          "light": "#B05A0C",
          "dark": "#F2AE6B",
          "usage": "Crayon tag: Nursery (marigold)."
        },
        "class-lkg": {
          "light": "#2F8547",
          "dark": "#86D09A",
          "usage": "Crayon tag: LKG (leaf)."
        },
        "class-ukg": {
          "light": "#2E5FBF",
          "dark": "#8EB0F0",
          "usage": "Crayon tag: UKG (sky)."
        },
        "school-accent": {
          "light": "#2E5FBF",
          "dark": "#2B4C8F",
          "usage": "Per-school brand colour (set at runtime from school settings). Parent app header + school logo only."
        },
        "on-school-accent": {
          "light": "#FFFFFF",
          "dark": "#FFFFFF",
          "usage": "Text on school-accent (recompute per school)."
        },
        "ruled": {
          "light": "#E4ECF8",
          "dark": "#1F2740",
          "usage": "Notebook ruled lines (.bd-paper)."
        },
        "margin": {
          "light": "#F4C9C9",
          "dark": "#4A2A33",
          "usage": "Notebook red margin line (.bd-paper.bd-margin)."
        },
        "deco-sun": {
          "light": "#FFC93C",
          "dark": "#F5C24A",
          "usage": "Doodle sun."
        },
        "deco-cloud": {
          "light": "#FFFFFF",
          "dark": "#DCE5F5",
          "usage": "Doodle cloud."
        },
        "deco-star": {
          "light": "#FFE08A",
          "dark": "#F7D88A",
          "usage": "Doodle stars and gold-star stickers."
        }
      }
    }
  }
}