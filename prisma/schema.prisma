// BloomDesk database. Every school-owned table has a school_id, and every query in
// src/lib filters by the signed-in member's school. Columns and tables use snake_case
// in PostgreSQL and camelCase in TypeScript.
//
// Checks Prisma can't express (name lengths, the +91 mobile format, seat limits) are
// added by hand at the end of the first migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Sign-in ----------

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always stored lower-case.
  email           String    @unique
  name            String
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions       Session[]
  tokens         AuthToken[]
  memberships    SchoolMember[]
  schoolsCreated School[]       @relation("SchoolCreatedBy")
  attendance     Attendance[]   @relation("AttendanceMarkedBy")

  @@map("users")
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256 hash is stored here.
model Session {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum TokenPurpose {
  verify_email
  reset_password

  @@map("token_purpose")
}

/// One-time links sent by email. Only the SHA-256 hash of the token is stored.
model AuthToken {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at") @db.Timestamptz
  usedAt    DateTime?    @map("used_at") @db.Timestamptz
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// Fixed-window counters for login, sign-up and password reset attempts.
model RateLimit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz
  count       Int      @default(1)

  @@id([key, windowStart])
  @@map("rate_limits")
}

// ---------- Schools ----------

enum MemberRole {
  owner
  admin
  teacher
  parent

  @@map("member_role")
}

model School {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  city        String?
  phone       String?
  timezone    String   @default("Asia/Kolkata")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  createdBy  User?          @relation("SchoolCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members    SchoolMember[]
  classes    SchoolClass[]
  children   Child[]
  attendance Attendance[]

  @@map("schools")
}

model SchoolMember {
  schoolId  String     @map("school_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      MemberRole
  fullName  String?    @map("full_name")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([schoolId, userId])
  @@index([userId])
  @@map("school_members")
}

enum ClassLevel {
  playgroup
  nursery
  lkg
  ukg
  daycare
  other

  @@map("class_level")
}

model SchoolClass {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String     @map("school_id") @db.Uuid
  name      String
  level     ClassLevel @default(other)
  capacity  Int?
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  children   Child[]
  attendance Attendance[]

  /// One class name per school.
  @@unique([schoolId, name])
  @@map("classes")
}

enum Gender {
  girl
  boy
  other

  @@map("gender")
}

enum ChildStatus {
  active
  left

  @@map("child_status")
}

model Child {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String      @map("school_id") @db.Uuid
  classId     String?     @map("class_id") @db.Uuid
  fullName    String      @map("full_name")
  dateOfBirth DateTime?   @map("date_of_birth") @db.Date
  gender      Gender?
  parentName  String?     @map("parent_name")
  /// 10-digit Indian mobile without +91, e.g. 9876543210.
  parentPhone String?     @map("parent_phone")
  joinedOn    DateTime    @default(dbgenerated("CURRENT_DATE")) @map("joined_on") @db.Date
  status      ChildStatus @default(active)
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  attendance Attendance[]

  @@unique([id, schoolId])
  @@index([schoolId, classId])
  @@map("children")
}

enum AttendanceStatus {
  present
  absent
  late
  leave

  @@map("attendance_status")
}

/// One mark per child per day.
model Attendance {
  childId    String           @map("child_id") @db.Uuid
  schoolId   String           @map("school_id") @db.Uuid
  date       DateTime         @db.Date
  status     AttendanceStatus
  classId    String?          @map("class_id") @db.Uuid
  note       String?
  markedById String?          @map("marked_by") @db.Uuid
  markedAt   DateTime         @default(now()) @map("marked_at") @db.Timestamptz

  // The composite key makes it impossible to file a child's attendance under another school.
  child    Child        @relation(fields: [childId, schoolId], references: [id, schoolId], onDelete: Cascade)
  school   School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class    SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  markedBy User?        @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@id([childId, date])
  @@index([schoolId, date])
  @@map("attendance")
}
