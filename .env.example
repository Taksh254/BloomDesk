# Copy to .env (used by both Next.js and the Prisma CLI).

# PostgreSQL 15+. This matches the local database from `npm run db:start`.
DATABASE_URL="postgresql://bloomdesk:bloomdesk@127.0.0.1:54329/bloomdesk"

# The app's public address, used in email links. Required in production;
# in development it defaults to the address you opened the app on.
# APP_URL="http://localhost:3000"

# Where emails go. "console" prints them (with their links) in the dev server's terminal,
# and is the default in development. No real provider is wired up yet.
# EMAIL_PROVIDER="console"
